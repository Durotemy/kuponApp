{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],

  "paths": {
    "@/*":[
      "src/*"
    ],
    "@/shared":[
      "src/components/shared/*"
    ],
    "@/screens":[
      "src/screens/*"
    ],
    "@/hooks":[
      "src/hooks"
    ]
  }
}
